# Database Configuration
# Add MYSQL_ROOT_PASSWORD and remove MYSQL_HOST if you're using docker
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbpass
MYSQL_DATABASE=dbname

# Redis Configuration (Required for background job processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Application Configuration
NODE_ENV=development

# Folder Watcher Configuration (Optional - for automatic file processing)
# Monitor a directory for new stealer log archives and auto-process them
WATCHER_FOLDER_PATH=/path/to/incoming/logs
WATCHER_PROCESSED_PATH=/path/to/processed
WATCHER_FAILED_PATH=/path/to/failed
WATCHER_AUTO_DELETE=false
WATCHER_DEBOUNCE_MS=3000
WATCHER_USER_ID=system
WATCHER_USERNAME=folder-watcher